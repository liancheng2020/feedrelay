# Run npm run setup to create a private .env with an administrator password hash.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://localhost:8787
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
DATA_DIR=./data
EMBED_WORKER=0
COOKIE_SECURE=0

# Active outbound channel: feishu (default) or weixin. Weixin binds in the settings UI.
PUSH_CHANNEL=feishu

# Optional HTTP(S) proxy for YouTube @handle resolution and channel RSS only.
# No credentials, no implicit browser/system proxy. localhost means this server.
YOUTUBE_PROXY_URL=

# Explicitly enable only after confirming account, folder, collection and disclosure.
IMAP_ENABLED=0
IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# A separate Feishu application bot, outbound private messages only.
# Enable the bot, grant im:message:send_as_bot, publish to the intended user.
FEISHU_ENABLED=0
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OPEN_ID=

# Optional direct DeepSeek summaries. No checkout or separate summary service needed.
# Credentials stay on this server; requests and repairs share the persistent budget.
# Set current provider prices in CNY per million tokens, then confirm total budget
# and each source's disclosure in the authenticated UI. Disabled by default.
DEEPSEEK_ENABLED=0
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_INPUT_CNY_PER_MILLION=
DEEPSEEK_OUTPUT_CNY_PER_MILLION=

# Optional anonymous YouTube captions; requires the dedicated virtualenv below.
# python3 -m venv .cache/youtube-venv
# .cache/youtube-venv/bin/python -m pip install -r requirements-youtube.txt
# Set an absolute Python path. No browser cookies or video frame downloads.
YOUTUBE_CAPTIONS_ENABLED=0
YOUTUBE_CAPTIONS_PYTHON=
# Empty means direct; system/browser proxy is never inherited.
# Explicit HTTP(S) proxy only, without credentials. localhost refers to the worker host.
YOUTUBE_CAPTIONS_PROXY_URL=
# Optional local audio transcription when no public captions exist. Same Python/proxy.
# Install requirements-asr.txt and a local faster-whisper model first. No cloud ASR key.
YOUTUBE_ASR_ENABLED=0
# Default: .cache/asr-model (local CTranslate2 model directory, never downloaded by Worker).
YOUTUBE_ASR_MODEL=
# Docker only: set 1 before compose build; use /opt/youtube/bin/python above.
YOUTUBE_CAPTIONS_BUILD=0
