# Run npm run setup to create a private .env with an administrator password hash.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://localhost:8787
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
DATA_DIR=./data
EMBED_WORKER=0
COOKIE_SECURE=0

# Explicitly enable only after confirming account, folder, collection and disclosure.
IMAP_ENABLED=0
IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# A separate Feishu application bot, outbound private messages only.
# Enable the bot, grant im:message:send_as_bot, publish to the intended user.
FEISHU_ENABLED=0
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OPEN_ID=
