{
  "name": "feedrelay",
  "version": "0.3.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/main.ts\" \"vite --host 127.0.0.1\"",
    "demo": "cross-env FEEDRELAY_DEMO=1 NODE_ENV=development APP_ORIGIN=http://localhost:5183 DATA_DIR=data-demo COOKIE_SECURE=0 IMAP_ENABLED=0 FEISHU_ENABLED=0 npm run dev",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && vue-tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "start": "node dist/server/main.js",
    "worker": "node dist/server/worker.js",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "service": "node scripts/service.mjs",
    "build:site": "vue-tsc --noEmit -p tsconfig.site.json && node scripts/build-site.mjs",
    "capture:site": "npm run build && node scripts/capture-site.mjs",
    "preview:site": "node scripts/preview-site.mjs",
    "test:site": "playwright test --config playwright.site.config.ts",
    "reset-password": "node dist/scripts/reset-password.js",
    "backup": "node dist/scripts/backup.js",
    "restore": "node dist/scripts/restore.js",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts test/*.test.mjs",
    "probe:youtube": "node scripts/yt-dlp-probe.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@koa/bodyparser": "6.1.0",
    "@koa/router": "15.7.0",
    "@lucide/vue": "1.57.0",
    "dotenv": "18.0.8",
    "htmlparser2": "12.0.0",
    "imapflow": "2.4.3",
    "ipaddr.js": "2.5.0",
    "jsonrepair": "3.15.0",
    "koa": "3.2.1",
    "koa-session": "7.0.2",
    "koa-static": "5.0.0",
    "luxon": "3.7.2",
    "mailparser": "3.9.39",
    "qrcode": "1.5.4",
    "rss-parser": "3.13.0",
    "sanitize-html": "2.18.1",
    "undici": "7.30.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/koa": "3.0.3",
    "@types/koa-static": "4.0.4",
    "@types/luxon": "3.7.6",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-vue": "6.0.10",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
